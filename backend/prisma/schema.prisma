// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  // Stored lowercased and trimmed by the API so lookups are case-insensitive.
  email        String   @unique
  // bcrypt hash only; the plain password is never stored or returned.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authSessions AuthSession[]
}

// One row per logged-in browser. The cookie holds a random token; only its
// SHA-256 hash is stored, so a database leak cannot be replayed as a login.
model AuthSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
